{
  "name": "@dibs.ai/dibs",
  "version": "0.1.7",
  "description": "Shared task store for coding agents: CLI, MCP server and todo.txt, with plugins for Claude Code, opencode, Pi, Codex and Cursor.",
  "type": "module",
  "keywords": [
    "dibs",
    "ai-agents",
    "coding-agent",
    "task-manager",
    "todo",
    "todo.txt",
    "mcp",
    "mcp-server",
    "claude-code",
    "claude-code-plugin",
    "opencode",
    "opencode-plugin",
    "pi-package",
    "pi",
    "codex",
    "cursor",
    "dex",
    "things"
  ],
  "bin": {
    "dibs": "./lib/cli/index.js"
  },
  "files": [
    "lib/",
    "src/core/adapters/*/*.schema.json",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:ui": "nub run build && nub run build:agent claude-code && rex do test/e2e/panel.lua",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "nub run build",
    "check": "tsc && vitest run",
    "build:agent": "nub scripts/build-agent.ts",
    "pack:check": "nub pack --dry-run",
    "release": "nub scripts/release.ts",
    "bump": "nub scripts/bump.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "dax": "^0.50.2",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "author": {
    "name": "arobida",
    "url": "https://github.com/arobida"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "agents/pi",
    "agents/opencode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arobida/dibs.git"
  },
  "homepage": "https://github.com/arobida/dibs#readme",
  "bugs": {
    "url": "https://github.com/arobida/dibs/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/core/tasks.d.ts",
      "default": "./lib/core/tasks.js"
    },
    "./core/*.ts": {
      "types": "./lib/core/*.d.ts",
      "default": "./lib/core/*.js"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.11.1",
      "onFail": "ignore"
    }
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false
  }
}
