{
  "name": "dibs-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/pi",
    "plugins/opencode"
  ],
  "scripts": {
    "build": "nub run --cwd packages/dibs build",
    "test": "cd packages/dibs && vitest run",
    "check": "tsc && nub run test",
    "test:ui": "nub run build && nub run build:agent claude-code && rex do packages/dibs/test/e2e/panel.lua",
    "build:agent": "nub scripts/build-agent.ts",
    "release": "nub scripts/release.ts",
    "bump": "nub scripts/bump.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "dax": "^0.50.2",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.11.1",
      "onFail": "ignore"
    }
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false
  }
}
